# OpenRouter API Key for LLM access
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE

# Vector Store Configuration
# CHROMA_DB_PATH=./chroma_db
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5   (rebuild chroma_db after changing)

# PostgreSQL (store data). Inside docker compose this is set automatically.
# POSTGRES_PORT is the port on your machine; keep it in sync with DATABASE_URL.
# POSTGRES_PORT=5433
# Host ports for the Docker stack (docker compose up)
# API_PORT=8000
# FRONTEND_PORT=8501
DATABASE_URL=postgresql://rag:rag@localhost:5432/store
# POSTGRES_USER=rag
# POSTGRES_PASSWORD=rag
# POSTGRES_DB=store
# Read-only role used by the SQL agent (created by create_sql_db)
# DATABASE_READER_USER=store_reader
# DATABASE_READER_PASSWORD=store_reader

# Faster model for routing questions to agents
# ROUTER_LLM_MODEL=google/gemini-2.5-flash-lite
